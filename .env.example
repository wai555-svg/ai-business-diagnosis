# このファイルをコピーして .env.local を作成し、値を設定してください。
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY 以外は未設定のままでもローカルでの動作確認は可能です
# （GA4/Meta Pixelは読み込まれません）。
# ただし相談フォームの送信内容を保存するには SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY が必須です
# （supabase/schema.sql で作成した leads テーブルへ保存します）。

# --- Supabase（相談データの永続保存先。サーバー専用、NEXT_PUBLIC_を付けないこと） ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Analytics 4 ---
# GA4の測定ID（例: G-XXXXXXXXXX）。空の場合、GA4タグは読み込まれません。
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Meta Pixel ---
# Meta Pixel ID（数字のみ）。空の場合、Pixelタグは読み込まれません。
NEXT_PUBLIC_META_PIXEL_ID=

# --- 相談フォームのメール通知（Resend https://resend.com を利用） ---
# ResendのAPIキー。空の場合、メール通知は送信されません。
RESEND_API_KEY=
# 通知を受け取る管理者のメールアドレス
ADMIN_NOTIFY_EMAIL=
# 送信元メールアドレス（Resendで検証済みドメインが必要。未設定時はテスト用アドレスを使用）
LEAD_NOTIFY_FROM_EMAIL=onboarding@resend.dev

# --- 相談フォームのWebhook通知（任意） ---
# Slack Incoming Webhook、Zapier等、JSONをPOSTできるURLなら何でも可。空の場合は送信されません。
LEADS_WEBHOOK_URL=

# --- 管理画面(/admin)のパスワード ---
# 本番環境では必ず設定してください。未設定の場合、本番では/adminにアクセスできません。
# ローカル開発時は未設定でも "dev-admin" でログインできます。
ADMIN_ACCESS_KEY=
